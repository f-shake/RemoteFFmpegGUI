<Window
    x:Class="SimpleFFmpegGUI.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ixt="clr-namespace:iNKORE.Extension;assembly=Inkore.Extension"
    xmlns:local="clr-namespace:SimpleFFmpegGUI.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:panels="clr-namespace:SimpleFFmpegGUI.WPF.Panels"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="FFmpeg 工具箱"
    Width="1400"
    Height="720"
    MinWidth="1000"
    MinHeight="400"
    ui:WindowHelper.SystemBackdropType="None"
    ui:WindowHelper.UseModernWindowStyle="True"
    AllowDrop="True"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo Description="FFmpeg 工具箱" />
    </Window.TaskbarItemInfo>
    <Grid x:Name="grdMain">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480" MinWidth="320" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="grdLeft">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl x:Name="taskHost" Margin="8,8,0,0" />
            <ui:CommandBar Grid.Row="1">
                <ui:AppBarButton Command="{Binding ShowMediaInfoCommand}" Label="查询媒体信息">
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Zoom}" />
                    </ui:AppBarButton.Icon>
                </ui:AppBarButton>
                <ui:AppBarSeparator />
                <ui:AppBarButton Command="{Binding StartQueueCommand}" Label="开始队列" Visibility="{Binding StartMainQueueButtonVisibility}">
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Play}" />
                    </ui:AppBarButton.Icon>
                </ui:AppBarButton>
                <ui:AppBarButton Command="{Binding StopQueueCommand}" Label="终止队列" Visibility="{Binding StopMainQueueButtonVisibility}">
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Stop}" />
                    </ui:AppBarButton.Icon>
                </ui:AppBarButton>
                <ui:AppBarButton Command="{Binding ShowAddTaskCommand}" Label="创建任务">
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}" />
                    </ui:AppBarButton.Icon>
                </ui:AppBarButton>
                <ui:CommandBar.SecondaryCommands>
                    <ui:AppBarButton Command="{Binding ShowSettingsCommand}" Label="设置">
                        <ui:AppBarButton.Icon><ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Settings}" /></ui:AppBarButton.Icon>
                    </ui:AppBarButton>
                    <ui:AppBarButton Command="{Binding ShowTasksCommand}" Label="查看所有任务">
                        <ui:AppBarButton.Icon><ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.List}" /></ui:AppBarButton.Icon>
                    </ui:AppBarButton>
                    <ui:AppBarButton Command="{Binding ShowPresetsCommand}" Label="查看预设">
                        <ui:AppBarButton.Icon><ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Shop}" /></ui:AppBarButton.Icon>
                    </ui:AppBarButton>
                    <ui:AppBarButton Command="{Binding ShowLogsCommand}" Label="查看日志">
                        <ui:AppBarButton.Icon><ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.History}" /></ui:AppBarButton.Icon>
                    </ui:AppBarButton>
                    <ui:AppBarButton Command="{Binding ShowTestsCommand}" Label="编码性能测试">
                        <ui:AppBarButton.Icon><ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Stopwatch}" /></ui:AppBarButton.Icon>
                    </ui:AppBarButton>
                    <ui:AppBarButton Command="{Binding ShowFFmpegOutputsCommand}" Label="FFmpeg输出命令行">
                        <ui:AppBarButton.Icon><ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.CommandPrompt}" /></ui:AppBarButton.Icon>
                    </ui:AppBarButton>
                </ui:CommandBar.SecondaryCommands>
            </ui:CommandBar>
        </Grid>
        <Border Grid.Column="1" Background="#33000000" />
        <ContentControl x:Name="statusHost" Grid.Column="2" Margin="12" />
        <ixt:ProgressRingOverlay
            x:Name="ring"
            Grid.ColumnSpan="99"
            Margin="-8" />
    </Grid>
</Window>