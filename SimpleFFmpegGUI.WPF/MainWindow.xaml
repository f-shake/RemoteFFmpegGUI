<Window
    x:Class="SimpleFFmpegGUI.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ixt="clr-namespace:iNKORE.Extension;assembly=Inkore.Extension"
    xmlns:local="clr-namespace:SimpleFFmpegGUI.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:panels="clr-namespace:SimpleFFmpegGUI.WPF.Panels"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="FFmpeg 工具箱"
    Width="1400"
    Height="720"
    MinWidth="1000"
    MinHeight="400"
    ui:WindowHelper.SystemBackdropType="None"
    ui:WindowHelper.UseModernWindowStyle="True"
    AllowDrop="True"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo Description="FFmpeg 工具箱" />
    </Window.TaskbarItemInfo>
    <Grid x:Name="grdMain">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="*"
                MinWidth="300" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition
                Width="2*"
                MinWidth="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:CommandBar
            Grid.Row="2"
            Grid.ColumnSpan="3">
            <ui:AppBarButton
                Command="{Binding ShowSettingsCommand}"
                Label="设置">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Settings}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>

            <ui:AppBarSeparator />

            <ui:AppBarButton
                Command="{Binding ShowMediaInfoCommand}"
                Label="查询元数据">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Zoom}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>

            <ui:AppBarButton
                Command="{Binding ShowTasksCommand}"
                Label="历史任务">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.List}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>

            <ui:AppBarButton
                Command="{Binding ShowPresetsCommand}"
                Label="预设">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Shop}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>
            <ui:AppBarButton
                Command="{Binding ShowLogsCommand}"
                Label="日志">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.History}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>

            <ui:AppBarButton
                Command="{Binding ShowTestsCommand}"
                Label="编码测试">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Stopwatch}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>

            <ui:AppBarButton
                Command="{Binding ShowFFmpegOutputsCommand}"
                Label="FFmpeg输出">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.CommandPrompt}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>

            <ui:AppBarSeparator />

            <ui:AppBarButton
                Command="{Binding StartQueueCommand}"
                Label="开始队列"
                Visibility="{Binding StartMainQueueButtonVisibility}">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Play}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>
            <ui:AppBarButton
                Command="{Binding StopQueueCommand}"
                Label="终止队列"
                Visibility="{Binding StopMainQueueButtonVisibility}">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Stop}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>

            <ui:AppBarButton
                Command="{Binding ShowAddTaskCommand}"
                Label="创建任务">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>
        </ui:CommandBar>
        <Grid
            x:Name="grdLeft"
            Grid.Column="0">
            <ContentControl
                x:Name="taskHost"
                Margin="8,8,0,0" />
        </Grid>
        <GridSplitter
            Grid.Column="1"
            Width="2"
            Margin="0,32,0,32"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns" />
        <ContentControl
            x:Name="statusHost"
            Grid.Column="2"
            Margin="12" />
        <Grid
            x:Name="detailOverlay"
            Grid.ColumnSpan="99"
            Visibility="{Binding Content.DataContext.Tasks.SelectedTask, ElementName=taskHost, Converter={StaticResource NotNullConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <!--  半透明遮罩（仅遮罩中间分隔线与右侧状态区，保留左侧任务清单可点击）：点击遮罩即收起详情  -->
            <Border
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Background="#30000000"
                MouseLeftButtonDown="DetailOverlay_MouseLeftButtonDown" />
            <!--  任务详情浮层卡片（浮在任务清单右侧、正在执行任务上方）  -->
            <Border
                Grid.Column="2"
                MaxHeight="700"
                Margin="12"
                Padding="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <panels:TaskDetailPanel DataContext="{Binding Content.DataContext, ElementName=taskHost}" />
            </Border>
        </Grid>
        <ixt:ProgressRingOverlay
            x:Name="ring"
            Grid.ColumnSpan="99"
            Margin="-8" />
        <!--  有任意任务正在执行时：主窗口显示闪烁的边框（5 秒周期）；全部暂停则橙色稳定（不闪）  -->
        <Border
            x:Name="RunStatusBorder"
            Grid.ColumnSpan="99"
            BorderThickness="2"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="LimeGreen" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding IsRunning}"
                            Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding IsAllPaused}"
                            Value="True">
                            <Setter Property="BorderBrush" Value="Orange" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</Window>