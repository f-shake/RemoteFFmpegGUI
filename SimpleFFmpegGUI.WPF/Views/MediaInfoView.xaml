<UserControl
    x:Class="SimpleFFmpegGUI.WPF.Views.MediaInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:ixt="clr-namespace:iNKORE.Extension;assembly=Inkore.Extension"
    xmlns:local="clr-namespace:SimpleFFmpegGUI.WPF.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:panels="clr-namespace:SimpleFFmpegGUI.WPF.Panels"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    AllowDrop="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="KeyStyle"
            TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="160" />
            <Setter Property="Padding" Value="2,8,12,8" />
        </Style>

    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="99">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="2"
                Height="32"
                Command="{Binding BrowseFileCommand}">
                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenFile}" />
            </Button>
        </Grid>
        <ScrollViewer
            xmlns:c="clr-namespace:SimpleFFmpegGUI.WPF.FzLib.WPF.Controls"
            xmlns:r="clr-namespace:SimpleFFmpegGUI.WPF"
            Grid.Row="2"
            c:SmoothScrollViewerHelper.SmoothScroll="{Binding Source={x:Static r:Config.Instance}, Path=SmoothScroll}"
            HorizontalScrollBarVisibility="Auto"
            Visibility="{Binding MediaInfo, Converter={StaticResource NotNullConverter}}">
            <ikw:SimpleStackPanel Spacing="8">
                <GroupBox Header="基本信息">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding}"
                                TextAlignment="Center" />
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <ikw:SimpleStackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource KeyStyle}">长度</TextBlock>
                            <TextBlock Text="{Binding MediaInfo.Duration, Mode=OneWay, StringFormat=hh\\:mm\\:ss\\.fff}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource KeyStyle}">格式</TextBlock>
                            <TextBlock Text="{Binding MediaInfo.Format}" />

                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource KeyStyle}">码率</TextBlock>
                            <TextBlock Text="{Binding MediaInfo.OverallBitRate, Converter={StaticResource Bitrate2StringConverter}}" />
                        </StackPanel>
                    </ikw:SimpleStackPanel>
                </GroupBox>

                <ItemsControl ItemsSource="{Binding MediaInfo.Videos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <GroupBox Header="{Binding Index}">
                                <GroupBox.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding ., StringFormat={}视频 {0}}"
                                            TextAlignment="Center" />
                                    </DataTemplate>
                                </GroupBox.HeaderTemplate>
                                <ikw:SimpleStackPanel
                                    Margin="0,0,0,16"
                                    Spacing="4">

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource KeyStyle}">编码</TextBlock>
                                        <TextBlock Text="{Binding Format}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="编码预设" />
                                        <TextBlock Text="{Binding Format_Profile}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="码率" />
                                        <TextBlock Text="{Binding BitRate, Converter={StaticResource Bitrate2StringConverter}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="帧率" />
                                        <TextBlock Text="{Binding FrameRate, StringFormat={}{0:0.000}}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="分辨率" />
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}×{1}">
                                                    <Binding Path="Width" />
                                                    <Binding Path="Height" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="比例" />
                                        <TextBlock Text="{Binding DisplayAspectRatio, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="像素格式" />
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="ColorSpace" />
                                                    <Binding Path="ChromaSubsampling" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="色彩深度" />
                                        <TextBlock Text="{Binding BitDepth}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="旋转" />
                                        <TextBlock Text="{Binding Rotation}" />
                                    </StackPanel>
                                    <Expander
                                        Header="编码设置"
                                        Visibility="{Binding EncodingSettings, Converter={StaticResource CountMoreThanZeroConverter}}">
                                        <ItemsControl ItemsSource="{Binding EncodingSettings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource KeyStyle}"
                                                            Text="{Binding Name}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Text="{Binding Value}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </ikw:SimpleStackPanel>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding MediaInfo.Audios}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <GroupBox Header="{Binding Index}">
                                <GroupBox.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding ., StringFormat={}音频 {0}}"
                                            TextAlignment="Center" />
                                    </DataTemplate>
                                </GroupBox.HeaderTemplate>
                                <ikw:SimpleStackPanel
                                    Margin="0,0,0,16"
                                    Spacing="4">

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource KeyStyle}">编码</TextBlock>
                                        <TextBlock Text="{Binding Format}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="码率" />
                                        <TextBlock Text="{Binding BitRate, Converter={StaticResource Bitrate2StringConverter}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="声道数" />
                                        <TextBlock Text="{Binding Channels}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="声道布局" />
                                        <TextBlock Text="{Binding ChannelLayout}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="采样率" />
                                        <TextBlock Text="{Binding SamplingRate}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="默认" />
                                        <TextBlock Text="{Binding Default}" />
                                    </StackPanel>
                                </ikw:SimpleStackPanel>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding MediaInfo.Texts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <GroupBox Header="{Binding Index}">
                                <GroupBox.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding ., StringFormat={}字幕 {0}}"
                                            TextAlignment="Center" />
                                    </DataTemplate>
                                </GroupBox.HeaderTemplate>
                                <ikw:SimpleStackPanel
                                    Margin="0,0,0,16"
                                    Spacing="4">

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource KeyStyle}">编码</TextBlock>
                                        <TextBlock Text="{Binding Format}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="语言" />
                                        <TextBlock Text="{Binding Language}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="标题" />
                                        <TextBlock Text="{Binding Title}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource KeyStyle}"
                                            Text="默认" />
                                        <TextBlock Text="{Binding Default}" />
                                    </StackPanel>
                                </ikw:SimpleStackPanel>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ikw:SimpleStackPanel>
        </ScrollViewer>
        <ScrollViewer
            xmlns:c="clr-namespace:SimpleFFmpegGUI.WPF.FzLib.WPF.Controls"
            xmlns:r="clr-namespace:SimpleFFmpegGUI.WPF"
            Grid.Row="2"
            Grid.Column="2"
            c:SmoothScrollViewerHelper.SmoothScroll="{Binding Source={x:Static r:Config.Instance}, Path=SmoothScroll}">
            <GroupBox
                Margin="0,0,16,0"
                Header="详情"
                Visibility="{Binding MediaInfo, Converter={StaticResource NotNullConverter}}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding}"
                            TextAlignment="Center" />
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <TextBox
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="consolas"
                    MouseLeave="TextBox_MouseLeave"
                    Text="{Binding MediaInfo.Raw}"
                    TextWrapping="Wrap" />
            </GroupBox>
        </ScrollViewer>
        <GridSplitter
            Grid.Row="2"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent" />
    </Grid>
</UserControl>