<UserControl
    x:Class="SimpleFFmpegGUI.WPF.Views.SettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:SimpleFFmpegGUI.WPF.FzLib.WPF.Controls"
    xmlns:converters="clr-namespace:SimpleFFmpegGUI.WPF.FzLib.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:ixt="clr-namespace:iNKORE.Extension;assembly=Inkore.Extension"
    xmlns:local="clr-namespace:SimpleFFmpegGUI.WPF.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:panels="clr-namespace:SimpleFFmpegGUI.WPF.Panels"
    xmlns:r="clr-namespace:SimpleFFmpegGUI.WPF"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    mc:Ignorable="d">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox Header="基本">
            <ikw:SimpleStackPanel
                Orientation="Vertical"
                Spacing="8">
                <CheckBox
                    Content="平滑滚动"
                    IsChecked="{Binding Configs.SmoothScroll}" />

                <ikw:SimpleStackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="记住上次的输出参数"
                        IsChecked="{Binding Configs.RememberLastArguments}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Opacity="0.5"
                        Text="开启该选项时，默认预设功能将不可用"
                        Visibility="{Binding Configs.RememberLastArguments, Converter={StaticResource Bool2VisibilityConverter}}" />
                </ikw:SimpleStackPanel>
                <ikw:SimpleStackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <ComboBox
                        Width="200"
                        ui:ControlHelper.Header="默认输出文件夹"
                        ItemsSource="{Binding DefaultOutputDirTypes}"
                        SelectedItem="{Binding Configs.DefaultOutputDirType}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ., Converter={StaticResource DescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox
                        Width="360"
                        ui:ControlHelper.Header="指定文件夹的名称"
                        Text="{Binding Configs.DefaultOutputDirInputSubDirName}"
                        Visibility="{Binding Configs.DefaultOutputDirType, Converter={StaticResource EqualConverter}, ConverterParameter=InputNewDir}" />
                    <TextBox
                        Width="360"
                        ui:ControlHelper.Header="指定文件夹的路径"
                        Text="{Binding Configs.DefaultOutputDirSpecialDirPath}"
                        Visibility="{Binding Configs.DefaultOutputDirType, Converter={StaticResource EqualConverter}, ConverterParameter=SpecialDir}" />
                    <Button
                        Height="32"
                        VerticalAlignment="Bottom"
                        Command="{Binding BrowseSpecialDirPathCommand}"
                        Visibility="{Binding Configs.DefaultOutputDirType, Converter={StaticResource EqualConverter}, ConverterParameter=SpecialDir}">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenFile}" />
                    </Button>
                </ikw:SimpleStackPanel>

                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="108" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="默认进程优先级" />
                    <Slider
                        Grid.Column="2"
                        Margin="0,-6,0,0"
                        IsSnapToTickEnabled="True"
                        LargeChange="01"
                        Maximum="4"
                        Minimum="0"
                        SmallChange="1"
                        TickFrequency="1"
                        TickPlacement="BottomRight"
                        Value="{Binding DefaultProcessPriority}" />
                    <TextBlock
                        Grid.Column="4"
                        HorizontalAlignment="Right"
                        Text="{Binding DefaultProcessPriority, Converter={StaticResource Index2StringConverter}, ConverterParameter=低;低于正常;正常;高于正常;高}" />
                </Grid>

                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="108" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="快照尺寸" />
                    <TextBox
                        Grid.Column="2"
                        VerticalContentAlignment="Center"
                        ui:ControlHelper.PlaceholderText="-1:1080"
                        Text="{Binding SnapshotSize, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

            </ikw:SimpleStackPanel>
        </GroupBox>
        <GroupBox
            Grid.Row="2"
            Header="远程管理主机">
            <DataGrid
                c:SmoothScrollViewerHelper.SmoothScroll="{Binding Configs.SmoothScroll}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="True"
                ItemsSource="{Binding ObservableRemoteHosts, UpdateSourceTrigger=PropertyChanged}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        Header="名称" />
                    <DataGridTextColumn
                        Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                        Header="地址" />
                    <DataGridTextColumn
                        Binding="{Binding Token, UpdateSourceTrigger=PropertyChanged}"
                        Header="连接密码" />
                    <!--
                        「源目录对应的本机位置」列：显示态是文本 + 「...」浏览按钮，双击进入编辑才出现输入框。
                        与 DataGridTextColumn / TestWindow 里"CellTemplate 用 TextBlock、CellEditingTemplate 用编辑器"
                        的写法一致，避免单元格里常驻一个带边框的输入框显得突兀
                    -->
                    <DataGridTemplateColumn
                        Width="*"
                        MinWidth="220">
                        <DataGridTemplateColumn.Header>
                            <TextBlock
                                Text="源目录对应的本机位置"
                                ToolTip="本机上对应远端输入目录（源目录）的位置，例如远端 \\NAS\共享\待处理 在本机是 Z:\待处理。远程提交时按它求相对路径、保留子目录；留空则只发文件名（要求文件在远端输入目录根下同名）。" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button
                                        Margin="4,0,0,0"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.BrowseRemoteHostLocalInputDirCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding}"
                                        Content="..."
                                        DockPanel.Dock="Right"
                                        ToolTip="选择本机上对应远端输入目录的位置" />
                                    <TextBlock
                                        Margin="8,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding LocalInputDir}"
                                        TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox
                                    VerticalAlignment="Center"
                                    Text="{Binding LocalInputDir, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="72"
                        Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.TestRemoteHostCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    CommandParameter="{Binding}"
                                    Content="测试" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <ui:CommandBar
            Grid.Row="4"
            Margin="-8"
            MouseEnter="CommandBar_MouseEnter">
            <ui:AppBarButton
                Command="{Binding AddRemoteHostCommand}"
                Label="新增远程主机">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>
            <ui:AppBarSeparator />
            <ui:AppBarButton
                Command="{Binding CancelCommand}"
                Label="取消">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Cancel}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>
            <ui:AppBarButton
                Command="{Binding SaveCommand}"
                Label="保存">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Save}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>
        </ui:CommandBar>
    </Grid>
</UserControl>