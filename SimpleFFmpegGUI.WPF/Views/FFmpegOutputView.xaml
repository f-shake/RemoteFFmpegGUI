<UserControl
    x:Class="SimpleFFmpegGUI.WPF.Views.FFmpegOutputView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:SimpleFFmpegGUI.WPF.FzLib.WPF.Controls"
    xmlns:converters="clr-namespace:SimpleFFmpegGUI.WPF.FzLib.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ixt="clr-namespace:iNKORE.Extension;assembly=Inkore.Extension"
    xmlns:local="clr-namespace:SimpleFFmpegGUI.WPF.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:panels="clr-namespace:SimpleFFmpegGUI.WPF.Panels"
    xmlns:r="clr-namespace:SimpleFFmpegGUI.WPF"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    mc:Ignorable="d">
    <DockPanel>

        <ui:CommandBar
            DockPanel.Dock="Bottom">
            <ui:AppBarButton
                Command="{Binding ClearAllCommand}"
                Label="清空">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Clear}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>
            <ui:AppBarButton
                Command="{Binding CopyAllCommand}"
                Label="复制全部内容">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Copy}" />
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>


        </ui:CommandBar>
        <ScrollViewer
            Name="scr"
            Margin="4">
            <ItemsControl
                Margin="0,0,20,0"
                ItemsSource="{Binding Outputs, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            FontFamily="Consolas"
                            PreviewMouseDown="TextBlock_PreviewMouseDown"
                            Text="{Binding Message}"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush
                                                        Opacity="0.5"
                                                        Color="{DynamicResource SystemAccentColor}" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Cursor" Value="Hand" />
                                        </Trigger>
                                        <DataTrigger
                                            Binding="{Binding Type}"
                                            Value="I">
                                            <Setter Property="Foreground" Value="Gray" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding Type}"
                                            Value="E">
                                            <Setter Property="Foreground" Value="Red" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding Type}"
                                            Value="W">
                                            <Setter Property="Foreground" Value="Orange" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>