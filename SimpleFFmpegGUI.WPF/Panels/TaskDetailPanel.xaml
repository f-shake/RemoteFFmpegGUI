<UserControl
    x:Class="SimpleFFmpegGUI.WPF.Panels.TaskDetailPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:SimpleFFmpegGUI.WPF.FzLib.WPF.Controls"
    xmlns:converters="clr-namespace:SimpleFFmpegGUI.WPF.FzLib.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:SimpleFFmpegGUI.Enums;assembly=SimpleFFmpegGUI.Core"
    xmlns:r="clr-namespace:SimpleFFmpegGUI.WPF"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    x:Name="root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer
            Margin="8"
            c:SmoothScrollViewerHelper.SmoothScroll="{Binding Source={x:Static r:Config.Instance}, Path=SmoothScroll}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid DataContext="{Binding Tasks.SelectedTask}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    FontWeight="Bold"
                    Text="类型" />
                <ikw:SimpleStackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="16">
                    <TextBlock Text="{Binding Type, Converter={StaticResource NameDescriptionAttributeValueConverter}}" />
                    <ui:HyperlinkButton
                        Margin="-8,-4"
                        Padding="8,4"
                        Background="Transparent"
                        Command="{Binding DataContext.ShowArgumentsCommand, ElementName=root}"
                        Content="详细参数"
                        Cursor="Hand" />
                </ikw:SimpleStackPanel>
                <TextBlock
                    Grid.Row="2"
                    FontWeight="Bold"
                    Text="状态" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    Text="{Binding Status, Converter={StaticResource DescriptionConverter}}" />
                <TextBlock
                    Grid.Row="4"
                    FontWeight="Bold"
                    Text="输入" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="4"
                    Text="{Binding InputDetailText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding InputDetailToolTipText}" />
                <TextBlock
                    Grid.Row="6"
                    FontWeight="Bold"
                    Text="输出" />
                <TextBlock
                    Grid.Row="6"
                    Grid.Column="2"
                    Text="{Binding OutputText}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />

                <TextBlock
                    Grid.Row="8"
                    FontWeight="Bold"
                    Text="创建时间" />
                <TextBlock
                    Grid.Row="8"
                    Grid.Column="2"
                    Text="{Binding CreateTime, StringFormat={StaticResource DateTimeFormat}}" />
                <TextBlock
                    Grid.Row="10"
                    FontWeight="Bold"
                    Text="执行时间"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="10" Grid.Column="2">
                    <Run Text="{Binding StartTime, StringFormat={StaticResource DateTimeFormat}, Mode=OneWay}" />
                    <Run Text="&#160;&#160;&#160;&#160;" />
                    <Run Text="{Binding FinishTime, StringFormat={StaticResource DateTimeFormat}, Mode=OneWay}" />
                </TextBlock>
                <TextBlock
                    Grid.Row="12"
                    FontWeight="Bold"
                    Text="信息" />
                <TextBlock
                    Grid.Row="12"
                    Grid.Column="2"
                    Text="{Binding Message}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="14"
                    FontWeight="Bold"
                    Text="FFmpeg参数" />
                <TextBlock
                    Grid.Row="14"
                    Grid.Column="2"
                    Text="{Binding FfmpegArguments}"
                    TextWrapping="Wrap" />
            </Grid>
        </ScrollViewer>


        <ui:AppBarButton
            Grid.Column="2"
            Label="更多"
            LabelPosition="Collapsed">
            <ui:AppBarButton.Icon>
                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.More}" />
            </ui:AppBarButton.Icon>
            <ui:AppBarButton.Flyout>
                <ui:MenuFlyout>
                    <MenuItem
                        Command="{Binding StartStandaloneCommand}"
                        Header="独立执行"
                        IsEnabled="{Binding CanStart}"
                        Visibility="{Binding ShowAllTasks, Converter={StaticResource Bool2VisibilityConverter}, ConverterParameter=i}" />
                    <MenuItem
                        Command="{Binding CancelCommand}"
                        Header="取消"
                        IsEnabled="{Binding CanCancel}"
                        ToolTip="取消执行任务，正在执行的任务会被停止"
                        Visibility="{Binding ShowAllTasks, Converter={StaticResource Bool2VisibilityConverter}, ConverterParameter=i}" />
                    <MenuItem
                        Command="{Binding ResetCommand}"
                        Header="重置"
                        IsEnabled="{Binding CanReset}"
                        ToolTip="将任务设置为排队状态"
                        Visibility="{Binding ShowAllTasks, Converter={StaticResource Bool2VisibilityConverter}, ConverterParameter=i}" />
                    <MenuItem
                        Command="{Binding CloneCommand}"
                        Header="建立副本" />
                    <MenuItem
                        Command="{Binding ShowLogsCommand}"
                        Header="查看日志" />
                    <MenuItem
                        Command="{Binding OpenOutputFileCommand}"
                        Header="打开目标文件"
                        Visibility="{Binding Status, Converter={StaticResource EqualConverter}, ConverterParameter={x:Static model:TaskStatus.Done}}" />
                    <MenuItem
                        Command="{Binding OpenOutputDirCommand}"
                        Header="打开目标文件目录"
                        Visibility="{Binding Status, Converter={StaticResource EqualConverter}, ConverterParameter={x:Static model:TaskStatus.Done}}" />

                </ui:MenuFlyout>
            </ui:AppBarButton.Flyout>
        </ui:AppBarButton>
    </Grid>
</UserControl>
