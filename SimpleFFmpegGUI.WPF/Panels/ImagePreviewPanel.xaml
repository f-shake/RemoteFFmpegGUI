<UserControl
    x:Class="SimpleFFmpegGUI.WPF.Panels.ImagePreviewPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:SimpleFFmpegGUI.WPF.ViewModels"
    x:Name="root"
    d:DataContext="{d:DesignInstance Type=vm:ImagePreviewPanelViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Focusable="True"
    Loaded="UserControl_Loaded"
    PreviewKeyDown="UserControl_PreviewKeyDown"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            视口：整个面板唯一的坐标参照系，自身不加任何变换（所有鼠标坐标都相对它取）。
            Background 必须设（否则该区域不可命中，滚轮与拖动都收不到）；颜色固定近黑，
            不跟随主题——亮色主题下浅灰底会让缩小的图与背景糊在一起，看图场景一律深底。
        -->
        <Border
            x:Name="viewport"
            Background="#FF1F1F1F"
            ClipToBounds="True"
            Cursor="Hand"
            MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
            MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
            MouseMove="Viewport_MouseMove"
            PreviewMouseWheel="Viewport_PreviewMouseWheel"
            SizeChanged="Viewport_SizeChanged">
            <!--
                左上对齐 + 显式宽高（加载时设为图片像素尺寸）+ RenderTransformOrigin="0,0"：
                三者缺一不可——居中/拉伸会让"图像空间 → 视口空间"多出一段偏移，公式全要跟着改；
                RenderTransformOrigin 默认是 (0.5,0.5)，不写就会绕元素中心缩放。
            -->
            <Image
                x:Name="img"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                RenderOptions.BitmapScalingMode="HighQuality"
                RenderTransformOrigin="0,0"
                Source="{Binding Source}"
                Stretch="Fill">
                <Image.RenderTransform>
                    <MatrixTransform x:Name="imgTransform" />
                </Image.RenderTransform>
            </Image>
        </Border>

        <Border
            Grid.Row="1"
            Padding="8,6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock
                    DockPanel.Dock="Right"
                    Margin="12,0,4,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    Text="{Binding SizeText}" />
                <TextBlock
                    DockPanel.Dock="Right"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    Text="{Binding ZoomText}" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        MinWidth="40"
                        Height="32"
                        Margin="0,0,4,0"
                        Click="ZoomOut_Click"
                        ToolTip="缩小">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ZoomOut}" />
                    </Button>
                    <Button
                        MinWidth="40"
                        Height="32"
                        Margin="0,0,4,0"
                        Click="ActuallySize_Click"
                        Content="1:1"
                        ToolTip="原始像素大小" />
                    <Button
                        MinWidth="40"
                        Height="32"
                        Margin="0,0,4,0"
                        Click="Fit_Click"
                        ToolTip="适应窗口">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.FitPage}" />
                    </Button>
                    <Button
                        MinWidth="40"
                        Height="32"
                        Click="ZoomIn_Click"
                        ToolTip="放大">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ZoomIn}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
