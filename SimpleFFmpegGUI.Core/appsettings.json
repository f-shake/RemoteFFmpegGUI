{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "LocalSqlite": "Data Source=db.sqlite"
  },
  "Urls": "http://localhost:5001",
  "DefaultProcessPriority":2,
  "AllowedHosts": "*",
  "InputDir": "input", //输入文件夹（相对部署目录的示例值，部署时改为实际目录）
  "OutputDir": "output", //输出文件夹（相对部署目录的示例值，部署时改为实际目录）
  "InputFtpPort": 36734, //输入文件夹FTP端口
  "OutputFtpPort": 36735, //输出文件夹FTP端口
  "FFmpegDir": "ffmpeg",
  "FFmpegFfmeDir": "ffmpeg_FFME",
  "Token": "" //鉴权令牌：留空则不鉴权；建议部署时设置强口令，调用方需在 Header 中携带 "Authorization: Bearer {Token}"
}
